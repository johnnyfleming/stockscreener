<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+).
    Exclude DataStore files that may contain portfolio/alert data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/myscreener_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/app_settings_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/myscreener_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/app_settings_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>